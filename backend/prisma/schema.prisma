generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://test_owner:5fpHjtxVIyE7@ep-still-tree-a54n066l.us-east-2.aws.neon.tech/test?sslmode=require"
}


model User {
  id String @id @default(uuid())
  email String @unique
  name String
  password String
  posts Recipe[]
  likes  Like[]
  comments Comment[]
}

model Recipe {
  id           Int         @id @default(autoincrement()) // Unique identifier
  title        String      // Title of the recipe
  ingredients  String    // List of ingredients (stored as an array of strings)
  instructions String      // Cooking instructions
  prepTime     Int         // Optional preparation time
  cookTime     Int         // Optional cooking time
  servings     Int         // Optional number of servings
  difficulty   Difficulty  // Optional difficulty level
  mealType     mealtype    // Optional tags for categorization
  upvotes      Int         @default(0) // Upvotes count
  image        String?     // Optional image URL or file path
  author       User        @relation(fields: [authorId], references: [id])
  authorId     String
  likes     Like[]
  comments Comment[]

  
  @@map("recipes") // Optional: rename the table to "recipes"
}

model Like {
  id        Int    @id @default(autoincrement())
  userId    String
  postId    Int
  user      User   @relation(fields: [userId], references: [id])
  post      Recipe @relation(fields: [postId], references: [id])

  @@unique([userId, postId]) // Ensures each user can like a post only once
}

model Comment {
  id        Int    @id @default(autoincrement())
  content   String 
  createdAt DateTime @default(now())
  userId    String
  postId    Int
  user      User   @relation(fields: [userId], references: [id])
  post      Recipe @relation(fields: [postId], references: [id])

  @@map("comments")
}

// Enum to match difficulty levels
enum Difficulty {
    easy
    medium
    hard
}

enum mealtype {
  breakfast
  lunch
  dinner
}